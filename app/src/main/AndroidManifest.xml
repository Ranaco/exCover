<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CropEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GiphySearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <service
            android:name=".GifWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/gif_wallpaper" />
            <!-- Motorola's cover-screen wallpaper picker only lists live wallpapers with these flags,
                 and the cover lock clock face only reveals a live wallpaper marked for lockscreen. -->
            <meta-data
                android:name="moto.cli.livewallpaper"
                android:value="true" />
            <meta-data
                android:name="moto.cli.livewallpaper.lockscreen"
                android:value="true" />
            <meta-data
                android:name="moto.cli.livewallpaper.homescreen"
                android:value="true" />
            <!-- Older clock face versions (Razr 50 on Android 16) ignore the homescreen flag: designs
                 with their own wallpaper list only offer live wallpapers tagged with that design.
                 Digital is the default design. -->
            <meta-data
                android:name="moto.cli.livewallpaper.templateId"
                android:value="digital" />
        </service>

        <!-- exCover's cover lock screen design (and its AOD state), for Motorola's clock face app.
             It lists the design from this provider, then binds the two services below to draw
             it; both permissions are held by the clock face app. The clock face app starts
             before the first unlock after a restart, so these must be available then too, or it
             drops exCover's design until the next app update. -->
        <provider
            android:name=".AodDesignProvider"
            android:authorities="${applicationId}.clockfaces"
            android:directBootAware="true"
            android:exported="true"
            android:readPermission="com.motorola.permission.READ_CLOCK_FACE_OPTIONS">
            <intent-filter>
                <action android:name="com.motorola.clockface.action.CLOCK_FACE_OPTIONS" />
            </intent-filter>
        </provider>

        <service
            android:name=".AodClockFaceService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="com.motorola.clockface_service"
                android:resource="@xml/clockface_service" />
        </service>

        <service
            android:name=".AodSessionService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="com.motorola.permission.BIND_CLOCK_FACE_SERVICE">
            <intent-filter>
                <action android:name="com.motorola.service.action.CLOCK_FACE_SESSION_SERVICE" />
            </intent-filter>
        </service>
    </application>
</manifest>
